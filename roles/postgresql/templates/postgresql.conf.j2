# Created by Adam Spandel, October 2026
# Purpose: Defines the managed PostgreSQL server configuration.
# Configures networking, authentication, logging and core database settings
# for PostgreSQL {{ postgresql_major_version }} on Rocky Linux 10+.
#
# This file is managed by Ansible. Manual changes may be overwritten.

#------------------------------------------------------------------------------
# CONNECTIONS AND AUTHENTICATION
#------------------------------------------------------------------------------

listen_addresses = '{{ postgresql_listen_addresses }}'
port = {{ postgresql_port }}
password_encryption = '{{ postgresql_password_encryption }}'

#------------------------------------------------------------------------------
# FILE LOCATIONS
#------------------------------------------------------------------------------

data_directory = '{{ postgresql_datadir }}'
hba_file = '{{ postgresql_datadir }}/pg_hba.conf'
ident_file = '{{ postgresql_datadir }}/pg_ident.conf'

#------------------------------------------------------------------------------
# LOGGING
#------------------------------------------------------------------------------

log_destination = 'stderr'
logging_collector = on
log_directory = 'pg_log'
log_filename = 'postgresql-%Y-%m-%d.log'
log_line_prefix = '%m [%p] '

#------------------------------------------------------------------------------
# LOCALE
#------------------------------------------------------------------------------

timezone = 'Europe/London'
log_timezone = 'Europe/London'

#------------------------------------------------------------------------------
# PROCESS TITLE
#------------------------------------------------------------------------------

cluster_name = 'postgresql{{ postgresql_major_version }}'

#------------------------------------------------------------------------------
# INCLUDE ADDITIONAL CONFIGURATION
#------------------------------------------------------------------------------

include_dir = 'conf.d'
